{
  "info": {
    "name": "ANSYNC - Booking Management API",
    "description": "Run in order against a local test workspace with a service. Set email/password locally and forbiddenTenantId to a workspace the user cannot access. Login uses Postman cookie jar. Creates and deletes one test booking; idempotency record remains. For unauthorized test disable cookie jar or clear localhost cookies if needed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "email",
      "value": "",
      "type": "string"
    },
    {
      "key": "password",
      "value": "",
      "type": "string"
    },
    {
      "key": "tenantId",
      "value": "",
      "type": "string"
    },
    {
      "key": "serviceId",
      "value": "",
      "type": "string"
    },
    {
      "key": "duration",
      "value": "",
      "type": "string"
    },
    {
      "key": "bookingId",
      "value": "",
      "type": "string"
    },
    {
      "key": "startTime",
      "value": "",
      "type": "string"
    },
    {
      "key": "editTime",
      "value": "",
      "type": "string"
    },
    {
      "key": "key",
      "value": "",
      "type": "string"
    },
    {
      "key": "overlapKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "forbiddenTenantId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{email}}\",\"password\":\"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Login user returned\", () => pm.expect(pm.response.json().user.id).to.be.a(\"number\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 My workspaces",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/my-workspaces"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const w = pm.response.json().workspaces;",
              "pm.test(\"Workspace exists\", () => pm.expect(w.length).to.be.above(0));",
              "if(w.length) pm.collectionVariables.set(\"tenantId\", String(w[0].id));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Services",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/services?tenantId={{tenantId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const s = pm.response.json().services;",
              "pm.test(\"Service exists\", () => pm.expect(s.length).to.be.above(0));",
              "if(s.length) { pm.collectionVariables.set(\"serviceId\", String(s[0].id)); pm.collectionVariables.set(\"duration\", String(s[0].duration)); }"
            ]
          }
        }
      ]
    },
    {
      "name": "04 List bookings",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/bookings?tenantId={{tenantId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Bookings array\", () => pm.expect(pm.response.json().bookings).to.be.an(\"array\"));",
              "const latest = Math.max(Date.now(), ...pm.response.json().bookings.map(b => Date.parse(b.endTime)));",
              "const start = new Date(latest + 86400000);",
              "pm.collectionVariables.set(\"startTime\", start.toISOString());",
              "pm.collectionVariables.set(\"editTime\", new Date(start.getTime() + (Number(pm.collectionVariables.get(\"duration\")) + 60)*60000).toISOString());",
              "pm.collectionVariables.set(\"key\", pm.variables.replaceIn(\"{{$guid}}\"));",
              "pm.collectionVariables.set(\"overlapKey\", pm.variables.replaceIn(\"{{$guid}}\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Create booking",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{key}}"
          }
        ],
        "url": "{{baseUrl}}/api/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\"tenantId\": {{tenantId}}, \"serviceId\": {{serviceId}}, \"startTime\": \"{{startTime}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const b = pm.response.json().booking;",
              "pm.collectionVariables.set(\"bookingId\", String(b.id));",
              "pm.test(\"Pending booking\", () => pm.expect(b.status).to.eql(\"PENDING\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Replay same key",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{key}}"
          }
        ],
        "url": "{{baseUrl}}/api/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\"tenantId\": {{tenantId}}, \"serviceId\": {{serviceId}}, \"startTime\": \"{{startTime}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Same booking ID\", () => pm.expect(String(pm.response.json().booking.id)).to.eql(pm.collectionVariables.get(\"bookingId\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Key conflict",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{key}}"
          }
        ],
        "url": "{{baseUrl}}/api/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\"tenantId\": {{tenantId}}, \"serviceId\": {{serviceId}}, \"startTime\": \"{{editTime}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));",
              "pm.test(\"Error code\", () => pm.expect(pm.response.json().error.code).to.eql(\"IDEMPOTENCY_CONFLICT\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Overlap conflict",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{overlapKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\"tenantId\": {{tenantId}}, \"serviceId\": {{serviceId}}, \"startTime\": \"{{startTime}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));",
              "pm.test(\"Error code\", () => pm.expect(pm.response.json().error.code).to.eql(\"BOOKING_CONFLICT\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Booking details",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/bookings/{{bookingId}}?tenantId={{tenantId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Correct booking\", () => pm.expect(String(pm.response.json().booking.id)).to.eql(pm.collectionVariables.get(\"bookingId\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Update booking",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bookings/{{bookingId}}?tenantId={{tenantId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"startTime\":\"{{editTime}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Updated time\", () => pm.expect(Date.parse(pm.response.json().booking.startTime)).to.eql(Date.parse(pm.collectionVariables.get(\"editTime\"))));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Invalid input",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": "{{baseUrl}}/api/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\"tenantId\": {{tenantId}}, \"serviceId\": 0, \"startTime\": \"invalid\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Error code\", () => pm.expect(pm.response.json().error.code).to.eql(\"VALIDATION_ERROR\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Cross-tenant access",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/bookings?tenantId={{forbiddenTenantId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));",
              "pm.test(\"Error code\", () => pm.expect(pm.response.json().error.code).to.eql(\"FORBIDDEN\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Delete test booking",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/bookings/{{bookingId}}?tenantId={{tenantId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "14 Verify deletion",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/bookings/{{bookingId}}?tenantId={{tenantId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));",
              "pm.test(\"Error code\", () => pm.expect(pm.response.json().error.code).to.eql(\"BOOKING_NOT_FOUND\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "15 Unauthorized access",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/bookings?tenantId={{tenantId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
              "pm.test(\"Error code\", () => pm.expect(pm.response.json().error.code).to.eql(\"UNAUTHORIZED\"));"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    }
  ]
}